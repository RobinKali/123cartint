# 123Cartint - Apache Configuration (.htaccess)

# 1. Directory Index
DirectoryIndex index.html

# 2. Custom 404 Error Page
ErrorDocument 404 /404.html

# 3. Gzip Compression for Performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 4. Browser Caching for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 5. Security Headers
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  # Prevent clickjacking
  Header set X-Frame-Options "SAMEORIGIN"
  # Referrer policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Restrict unauthorized browser features
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 6. Disable Directory Listings
Options -Indexes

# 7. Block Sensitive and Dot Files
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "(package\.json|package-lock\.json|tsconfig\.json|astro\.config\.mjs|sanity\.config\.ts|sanity\.cli\.ts|\.env)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
