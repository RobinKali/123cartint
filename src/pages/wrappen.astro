---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Car Wrapping - Complete Transformatie">
  <Header />
  
  <main class="pt-20">
    <!-- Service Hero -->
    <div class="relative h-[60vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-transparent z-10" />
        <img 
          src="/images/portfolio/mat-zwart-wrap.jpg" 
          alt="Car Wrapping" 
          class="w-full h-full object-cover"
        />
      </div>
      <div class="relative z-20 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">Car <span class="text-gradient-gold">Wrapping</span></h1>
        <p class="text-xl text-gray-300 max-w-2xl mb-8">
          Geef uw voertuig een unieke uitstraling en bescherm de originele lak. Eindeloze mogelijkheden in kleur en finish.
        </p>
        <a href="/contact" class="inline-block px-8 py-4 bg-gold-500 text-black font-bold rounded-sm hover:bg-gold-400 transition-colors">
          Vraag offerte aan
        </a>
      </div>
    </div>

    <!-- Content Section -->
    <section class="py-24 bg-black">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
          <div>
            <h2 class="text-3xl font-bold text-white mb-6">De ultieme make-over voor uw auto</h2>
            <div class="space-y-8">
              <div>
                <h3 class="text-xl font-semibold text-gold-500 mb-2">Eindeloze Keuze</h3>
                <p class="text-gray-400">Kies uit honderden kleuren en finishes: mat, satijn, glans, metallic, color-flow (kameleon) of zelfs carbon fiber textuur.</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-gold-500 mb-2">Lakbescherming</h3>
                <p class="text-gray-400">Een wrap fungeert als een beschermende laag tegen steenslag, krassen en UV-straling, waardoor de originele lak in nieuwstaat blijft. Perfect voor de restwaarde van uw auto.</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-gold-500 mb-2">Volledig Omkeerbaar</h3>
                <p class="text-gray-400">Bent u toe aan iets nieuws of wilt u de auto verkopen? De wrap kan professioneel verwijderd worden zonder lijmresten achter te laten.</p>
              </div>
            </div>
          </div>
          <div class="bg-zinc-900 p-8 rounded-lg border border-zinc-800">
            <h3 class="text-2xl font-bold text-white mb-6">Populaire Wraps</h3>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-zinc-950 p-4 rounded text-center border border-zinc-800 hover:border-gold-500 transition-colors cursor-pointer">
                <div class="w-12 h-12 bg-black rounded-full mx-auto mb-3 shadow-[inset_0_2px_4px_rgba(255,255,255,0.1)]"></div>
                <span class="text-gray-300 font-medium">Mat Zwart</span>
              </div>
              <div class="bg-zinc-950 p-4 rounded text-center border border-zinc-800 hover:border-gold-500 transition-colors cursor-pointer">
                <div class="w-12 h-12 bg-[#4a4a4a] rounded-full mx-auto mb-3 shadow-[inset_0_2px_4px_rgba(255,255,255,0.3)]"></div>
                <span class="text-gray-300 font-medium">Satin Dark Grey</span>
              </div>
              <div class="bg-zinc-950 p-4 rounded text-center border border-zinc-800 hover:border-gold-500 transition-colors cursor-pointer">
                <div class="w-12 h-12 bg-[#2c5364] rounded-full mx-auto mb-3 shadow-[inset_0_2px_4px_rgba(255,255,255,0.2)]"></div>
                <span class="text-gray-300 font-medium">Midnight Blue</span>
              </div>
              <div class="bg-zinc-950 p-4 rounded text-center border border-zinc-800 hover:border-gold-500 transition-colors cursor-pointer">
                <div class="w-12 h-12 bg-gradient-to-tr from-purple-500 via-blue-500 to-green-500 rounded-full mx-auto mb-3"></div>
                <span class="text-gray-300 font-medium">Color Flow</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
