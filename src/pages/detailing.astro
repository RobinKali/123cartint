---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Cleaning & Detailing - Showroom Glans & Perfectie">
  <Header />
  
  <main class="pt-20">
    <!-- Service Hero -->
    <div class="relative h-[60vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-transparent z-10" />
        <img 
          src="/images/portfolio/keramische-coating.jpg" 
          alt="Auto Cleaning, Detailing en Keramische Coating" 
          class="w-full h-full object-cover"
        />
      </div>
      <div class="relative z-20 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">Cleaning & <span class="text-gradient-red">Detailing</span></h1>
        <p class="text-xl text-gray-300 max-w-2xl mb-8">
          Van professionele dieptereiniging en interieurverzorging tot lakcorrectie en hoogwaardige keramische glascoating (Gyeon / Modesta).
        </p>
        <a href="/contact" class="inline-block px-8 py-4 bg-red-500 text-black font-bold rounded-sm hover:bg-red-400 transition-colors">
          Neem contact op
        </a>
      </div>
    </div>

    <!-- Detailing & Polishing Content Section -->
    <section class="py-24 bg-black">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div>
            <span class="text-red-500 font-semibold text-sm uppercase tracking-wider">Lakcorrectie & Glans</span>
            <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">Tot in de kleinste details</h2>
            <div class="space-y-8">
              <div>
                <h3 class="text-xl font-semibold text-red-500 mb-2">Lakcorrectie (Meerstaps Polijsten)</h3>
                <p class="text-gray-400">Verwijder waskrassen (swirls), hologrammen en doffe plekken. Door middel van 1-, 2- of 3-staps polijsten brengen wij een diepe, spiegelachtige glans terug in de lak van uw auto.</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-red-500 mb-2">Ceramic Guard Glascoating</h3>
                <p class="text-gray-400">Een extreem harde en waterafstotende beschermlaag die zich hecht aan de lak. Biedt 3 tot 5 jaar bescherming tegen weersinvloeden, vogelpoep, UV-straling en maakt het wassen van de auto een fluitje van een cent.</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-red-500 mb-2">Dieptereiniging & Bescherming</h3>
                <p class="text-gray-400">Volledige behandeling van leder, alcantara en kunststof delen inclusief geavanceerde ozonbehandeling voor een 100% frisse interieurervaring.</p>
              </div>
            </div>
            
            <div class="mt-8">
              <a href="/prijzen#detailing" class="inline-flex items-center gap-2 text-red-500 hover:text-red-400 font-bold">
                Bekijk onze detailing & coating tarieven
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </div>

          <div class="bg-zinc-900 p-8 rounded-lg border border-zinc-800 h-full flex flex-col justify-center">
            <h3 class="text-2xl font-bold text-white mb-6">Onze Detailing Pakketten</h3>
            <ul class="space-y-6">
              <li class="border-b border-zinc-800 pb-6">
                <div class="flex justify-between items-baseline mb-1">
                  <h4 class="text-red-500 font-semibold">1-Staps Polijsten</h4>
                  <span class="text-sm font-bold text-white">v.a. € 239,-</span>
                </div>
                <p class="text-gray-400 text-sm">Glansherstel en lichte krascorrectie, inclusief duurzame lakverzegeling.</p>
              </li>
              <li class="border-b border-zinc-800 pb-6">
                <div class="flex justify-between items-baseline mb-1">
                  <h4 class="text-red-500 font-semibold">2-Staps Polijsten</h4>
                  <span class="text-sm font-bold text-white">v.a. € 299,-</span>
                </div>
                <p class="text-gray-400 text-sm">Verwijdert tot 80% van de krassen voor een diepe spiegelglans.</p>
              </li>
              <li class="border-b border-zinc-800 pb-6">
                <div class="flex justify-between items-baseline mb-1">
                  <h4 class="text-red-500 font-semibold">3-Staps Polijsten</h4>
                  <span class="text-sm font-bold text-white">v.a. € 379,-</span>
                </div>
                <p class="text-gray-400 text-sm">Maximale lakcorrectie tot 90% krasverwijdering voor de ultieme wet-look.</p>
              </li>
              <li>
                <div class="flex justify-between items-baseline mb-1">
                  <h4 class="text-red-500 font-semibold">Ceramic Guard Coating</h4>
                  <span class="text-sm font-bold text-white">v.a. € 950,-</span>
                </div>
                <p class="text-gray-400 text-sm">3 tot 5 jaar ultieme glans en lakbescherming met hydrofoob effect.</p>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Car Cleaning Section -->
    <section class="py-24 bg-zinc-950 border-t border-zinc-900" id="car-cleaning">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <span class="text-red-500 font-semibold text-sm uppercase tracking-wider">Professionele Schoonmaak</span>
          <h2 class="text-3xl md:text-5xl font-bold text-white mt-1 mb-4">Car Cleaning & Interieurverzorging</h2>
          <p class="text-gray-400 text-lg max-w-2xl mx-auto">
            Geen tijd of middelen om uw auto grondig te reinigen? Wij bieden flexibele reinigingspakketten van veilige handwas tot complete interieur renovatie.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
          <!-- Cleaning Card 1 -->
          <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 hover:border-red-500/50 transition-all flex flex-col justify-between">
            <div>
              <span class="text-xs text-red-500 uppercase font-bold">Exterieur</span>
              <h3 class="text-xl font-bold text-white mt-1 mb-2">Basis Wassen</h3>
              <p class="text-gray-400 text-sm mb-4">Wassen van de buitenzijde met professioneel 2-emmer systeem om krasjes te voorkomen.</p>
            </div>
            <div class="pt-4 border-t border-zinc-800 flex justify-between items-center">
              <span class="text-xs text-gray-500">Richttarief</span>
              <span class="text-lg font-bold text-red-500">v.a. € 35,-</span>
            </div>
          </div>

          <!-- Cleaning Card 2 -->
          <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 hover:border-red-500/50 transition-all flex flex-col justify-between">
            <div>
              <span class="text-xs text-red-500 uppercase font-bold">Interieur</span>
              <h3 class="text-xl font-bold text-white mt-1 mb-2">Interieur Clean</h3>
              <p class="text-gray-400 text-sm mb-4">Stofzuigen, dashboard en middenconsole ontvetten, ramen streeploos reinigen en matten behandelen.</p>
            </div>
            <div class="pt-4 border-t border-zinc-800 flex justify-between items-center">
              <span class="text-xs text-gray-500">Richttarief</span>
              <span class="text-lg font-bold text-red-500">v.a. € 75,-</span>
            </div>
          </div>

          <!-- Cleaning Card 3 -->
          <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 hover:border-red-500/50 transition-all flex flex-col justify-between">
            <div>
              <span class="text-xs text-red-500 uppercase font-bold">Leder</span>
              <h3 class="text-xl font-bold text-white mt-1 mb-2">Leerbehandeling</h3>
              <p class="text-gray-400 text-sm mb-4">Grondig reinigen van lederen zetels en aanbrengen van een hoogwaardige voedende leerconditioner.</p>
            </div>
            <div class="pt-4 border-t border-zinc-800 flex justify-between items-center">
              <span class="text-xs text-gray-500">Optie</span>
              <span class="text-lg font-bold text-red-500">Maatwerk</span>
            </div>
          </div>

          <!-- Cleaning Card 4 -->
          <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 hover:border-red-500/50 transition-all flex flex-col justify-between">
            <div>
              <span class="text-xs text-red-500 uppercase font-bold">Geur & Hygiëne</span>
              <h3 class="text-xl font-bold text-white mt-1 mb-2">Ozon Behandeling</h3>
              <p class="text-gray-400 text-sm mb-4">Permanent neutraliseren van hardnekkige geuren zoals rook, huisdieren en schimmels.</p>
            </div>
            <div class="pt-4 border-t border-zinc-800 flex justify-between items-center">
              <span class="text-xs text-gray-500">Optie</span>
              <span class="text-lg font-bold text-red-500">Maatwerk</span>
            </div>
          </div>
        </div>

        <div class="text-center">
          <a href="/prijzen#cleaning" class="inline-flex items-center gap-2 px-8 py-3.5 bg-red-500 text-black font-bold rounded hover:bg-red-400 transition-colors">
            Bekijk alle prijzen & details
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
