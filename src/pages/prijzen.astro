---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Prijzen & Tarieven - Transparante Prijslijst" description="Bekijk onze actuele tarieven voor autoruiten tinten, car cleaning, detailing, polijsten en keramische coatings. Transparant en eerlijk vakmanschap.">
  <Header />
  
  <main class="pt-20">
    <!-- Hero Section -->
    <div class="bg-black py-20 border-b border-zinc-900 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-amber-500/10 via-transparent to-transparent pointer-events-none"></div>
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-gold-500/10 text-gold-500 border border-gold-500/20 mb-4">
          Transparante Tarieven
        </span>
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
          Onze <span class="text-gradient-gold">Prijzen</span> & Pakketten
        </h1>
        <p class="text-gray-400 text-lg md:text-xl max-w-3xl mx-auto">
          Eerlijke en transparante prijzen voor het hoogste niveau in automotive styling en verzorging. 
          Al onze werkzaamheden worden uitgevoerd met premium A-kwaliteit materialen.
        </p>
      </div>
    </div>

    <!-- Quick Navigation Anchor Links -->
    <div class="bg-zinc-950/80 backdrop-blur-md sticky top-20 z-30 border-b border-zinc-800 py-4">
      <div class="max-w-7xl mx-auto px-4 flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-sm font-medium">
        <a href="#tinten" class="px-4 py-2 rounded-full text-gray-300 hover:text-black hover:bg-gold-500 transition-all">Autoruiten Tinten</a>
        <a href="#cleaning" class="px-4 py-2 rounded-full text-gray-300 hover:text-black hover:bg-gold-500 transition-all">Car Cleaning</a>
        <a href="#detailing" class="px-4 py-2 rounded-full text-gray-300 hover:text-black hover:bg-gold-500 transition-all">Detailing & Polijsten</a>
        <a href="#coating" class="px-4 py-2 rounded-full text-gray-300 hover:text-black hover:bg-gold-500 transition-all">Ceramic Coating</a>
        <a href="#cadeaubon" class="px-4 py-2 rounded-full text-gold-500 border border-gold-500/40 hover:bg-gold-500 hover:text-black transition-all">🎁 Cadeaubon</a>
      </div>
    </div>

    <!-- SECTION 1: AUTORUITEN TINTEN -->
    <section class="py-20 bg-black scroll-mt-36" id="tinten">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
          <div>
            <span class="text-gold-500 font-semibold text-sm uppercase tracking-wider">Raamfolie & Blinderen</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white mt-1">Autoruiten Tinten</h2>
          </div>
          <p class="text-gray-400 text-sm mt-2 md:mt-0 max-w-md">
            Genoemde prijzen zijn vanaf de B-stijl, inclusief 21% BTW en montagegarantie.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
          <!-- Item: Hatchback 3 deurs -->
          <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 hover:border-gold-500/50 transition-all group">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="text-xl font-bold text-white group-hover:text-gold-500 transition-colors">Hatchback</h3>
                <span class="text-sm text-gray-400">3-deurs uitvoering</span>
              </div>
              <span class="text-2xl font-extrabold text-gold-500">€ 160,-</span>
            </div>
            <p class="text-gray-400 text-sm mb-4">Achterruit en achterste zijruiten professioneel getint met warmtewerende kwaliteitsfolie.</p>
            <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between text-xs text-gray-400">
              <span>Incl. montage & BTW</span>
              <span class="text-gold-500">Vanaf B-stijl</span>
            </div>
          </div>

          <!-- Item: Hatchback 5 deurs -->
          <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 hover:border-gold-500/50 transition-all group">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="text-xl font-bold text-white group-hover:text-gold-500 transition-colors">Hatchback</h3>
                <span class="text-sm text-gray-400">5-deurs uitvoering</span>
              </div>
              <span class="text-2xl font-extrabold text-gold-500">€ 190,-</span>
            </div>
            <p class="text-gray-400 text-sm mb-4">Volledige achterzijde (achterruit + 4 zijruiten) voorzien van strakke UV-werende folie.</p>
            <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between text-xs text-gray-400">
              <span>Incl. montage & BTW</span>
              <span class="text-gold-500">Vanaf B-stijl</span>
            </div>
          </div>

          <!-- Item: Sedan -->
          <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 hover:border-gold-500/50 transition-all group">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="text-xl font-bold text-white group-hover:text-gold-500 transition-colors">Sedan</h3>
                <span class="text-sm text-gray-400">Alle modellen</span>
              </div>
              <span class="text-2xl font-extrabold text-gold-500">€ 210,-</span>
            </div>
            <p class="text-gray-400 text-sm mb-4">Achterruit en achterportieren met perfecte pasvorm en naadloze randafwerking.</p>
            <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between text-xs text-gray-400">
              <span>Incl. montage & BTW</span>
              <span class="text-gold-500">Vanaf B-stijl</span>
            </div>
          </div>

          <!-- Item: Coupé -->
          <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 hover:border-gold-500/50 transition-all group">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="text-xl font-bold text-white group-hover:text-gold-500 transition-colors">Coupé</h3>
                <span class="text-sm text-gray-400">Sportieve 2/3-deurs</span>
              </div>
              <span class="text-2xl font-extrabold text-gold-500">€ 210,-</span>
            </div>
            <p class="text-gray-400 text-sm mb-4">Achterruit en zijramen strak afgewerkt voor een exclusieve, agressieve uitstraling.</p>
            <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between text-xs text-gray-400">
              <span>Incl. montage & BTW</span>
              <span class="text-gold-500">Vanaf B-stijl</span>
            </div>
          </div>

          <!-- Item: Stationcar (5 ramen) -->
          <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 hover:border-gold-500/50 transition-all group">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="text-xl font-bold text-white group-hover:text-gold-500 transition-colors">Stationcar</h3>
                <span class="text-sm text-gray-400">5 ramen totaal</span>
              </div>
              <span class="text-2xl font-extrabold text-gold-500">€ 210,-</span>
            </div>
            <p class="text-gray-400 text-sm mb-4">Achterruit en 4 zijruiten. Ideaal voor extra privacy en warmtereductie voor kinderen en honden.</p>
            <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between text-xs text-gray-400">
              <span>Incl. montage & BTW</span>
              <span class="text-gold-500">Vanaf B-stijl</span>
            </div>
          </div>

          <!-- Item: Stationcar (7 ramen) -->
          <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 hover:border-gold-500/50 transition-all group">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="text-xl font-bold text-white group-hover:text-gold-500 transition-colors">Stationcar</h3>
                <span class="text-sm text-gray-400">7 ramen (incl. extra spijlen/driehoekjes)</span>
              </div>
              <span class="text-2xl font-extrabold text-gold-500">€ 230,-</span>
            </div>
            <p class="text-gray-400 text-sm mb-4">Complete afwerking inclusief alle kleine ruitjes voor een 100% egale doorkijk.</p>
            <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between text-xs text-gray-400">
              <span>Incl. montage & BTW</span>
              <span class="text-gold-500">Vanaf B-stijl</span>
            </div>
          </div>

          <!-- Item: SUV -->
          <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 hover:border-gold-500/50 transition-all group md:col-span-2 lg:col-span-3">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4">
              <div>
                <h3 class="text-xl font-bold text-white group-hover:text-gold-500 transition-colors">SUV & Crossover</h3>
                <span class="text-sm text-gray-400">Grote voertuigen & terreinwagens</span>
              </div>
              <span class="text-3xl font-extrabold text-gold-500 mt-2 sm:mt-0">€ 260,-</span>
            </div>
            <p class="text-gray-400 text-sm mb-4">Complete professionele blindeerbehandeling vanaf de B-stijl voor royale SUV's.</p>
          </div>
        </div>

        <!-- Tinten Aanvullende Opties -->
        <div class="bg-zinc-950 border border-zinc-800 rounded-xl p-6">
          <h4 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Belangrijke details & Extra opties:
          </h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-300">
            <div class="flex items-start gap-3 bg-zinc-900/50 p-4 rounded-lg border border-zinc-800">
              <span class="text-gold-500 font-bold text-lg">+€60,-</span>
              <div>
                <strong class="text-white block">Voorportieren tinten</strong>
                <span>Meerprijs per ruit voor de voorste zijruiten (binnen de wettelijke lichtdoorlatendheidsnorm).</span>
              </div>
            </div>
            <div class="flex items-start gap-3 bg-zinc-900/50 p-4 rounded-lg border border-zinc-800">
              <span class="text-gold-500 font-bold text-lg">Info</span>
              <div>
                <strong class="text-white block">Dot-Matrix & BTW</strong>
                <span>Alle prijzen zijn inclusief 21% BTW en exclusief het eventueel wegwerken van de Dot-Matrix rand.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: CAR CLEANING -->
    <section class="py-20 bg-zinc-950 border-t border-zinc-900 scroll-mt-36" id="cleaning">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
          <div>
            <span class="text-gold-500 font-semibold text-sm uppercase tracking-wider">Interieur & Exterieur Verzorging</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white mt-1">Car Cleaning</h2>
          </div>
          <p class="text-gray-400 text-sm mt-2 md:mt-0 max-w-md">
            Van een grondige basis wasbeurt tot een complete showroom-waardige interieur reset.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
          <!-- Pakket 1: Basis Wassen -->
          <div class="bg-zinc-900/70 border border-zinc-800 rounded-xl p-8 hover:border-gold-500/50 transition-all flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-6">
                <div>
                  <h3 class="text-2xl font-bold text-white">Basis Exterieur Wassen</h3>
                  <p class="text-gray-400 text-sm mt-1">Grondige en veilige handwas</p>
                </div>
                <div class="text-right">
                  <span class="text-sm text-gray-400 block">v.a.</span>
                  <span class="text-3xl font-extrabold text-gold-500">€ 35,-</span>
                </div>
              </div>
              <ul class="space-y-3 mb-8 text-gray-300 text-sm">
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gold-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Afspuiten met hogedruk & actieve foam voorwas</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gold-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Zorgvuldig gewassen m.b.v. het veilige <strong>2-emmer systeem</strong> (anti-kras)</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gold-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Velgen reiniging en drogen met zachte microvezeldoeken</span>
                </li>
              </ul>
            </div>
            <a href="/contact" class="block text-center py-3 rounded-lg border border-zinc-700 text-white font-medium hover:border-gold-500 hover:text-gold-500 transition-colors">
              Afspraak Inplannen
            </a>
          </div>

          <!-- Pakket 2: Interieur Reiniging -->
          <div class="bg-zinc-900/70 border border-gold-500/40 rounded-xl p-8 shadow-xl shadow-gold-500/5 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute top-0 right-0 bg-gold-500 text-black text-xs font-bold px-4 py-1 rounded-bl-lg uppercase tracking-wider">
              Meest Gekozen
            </div>
            <div>
              <div class="flex justify-between items-start mb-6">
                <div>
                  <h3 class="text-2xl font-bold text-white">Interieur Reiniging & Diepteclean</h3>
                  <p class="text-gray-400 text-sm mt-1">Volledig fris, bacterievrij en vlekvrij interieur</p>
                </div>
                <div class="text-right">
                  <span class="text-sm text-gray-400 block">v.a.</span>
                  <span class="text-3xl font-extrabold text-gold-500">€ 75,-</span>
                </div>
              </div>
              <ul class="space-y-3 mb-8 text-gray-300 text-sm">
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gold-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Intensief stofzuigen van stoelen, banken, kofferbak en vloer</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gold-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Dashboard, middenconsole en alle deurpanelen reinigen</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gold-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Ramen binnen en buitenkant streeploos ontvetten</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-gold-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span>Dieptereiniging van vloermatten en stoffen bekleding</span>
                </li>
              </ul>
            </div>
            <a href="/contact" class="block text-center py-3 rounded-lg bg-gold-500 text-black font-bold hover:bg-gold-400 transition-colors">
              Boek Interieur Behandeling
            </a>
          </div>
        </div>

        <!-- Speciale Behandelingen -->
        <h3 class="text-xl font-bold text-white mb-6">Speciale Aanvullende Behandelingen</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-zinc-900/40 border border-zinc-800 rounded-xl p-6">
            <h4 class="text-gold-500 font-bold text-lg mb-2">Leerbehandeling</h4>
            <p class="text-gray-400 text-sm">Diepe reiniging van lederen bekleding gevolgd door een voedende leerconditioner die uitdroging en scheurtjes voorkomt.</p>
          </div>
          <div class="bg-zinc-900/40 border border-zinc-800 rounded-xl p-6">
            <h4 class="text-gold-500 font-bold text-lg mb-2">Dieptereiniging (Extractie)</h4>
            <p class="text-gray-400 text-sm">Speciale shampoobehandeling en vlekverwijdering voor hardnekkige vlekken, drankkringen en vet in stoffen bekleding.</p>
          </div>
          <div class="bg-zinc-900/40 border border-zinc-800 rounded-xl p-6">
            <h4 class="text-gold-500 font-bold text-lg mb-2">Ozon Geurbehandeling</h4>
            <p class="text-gray-400 text-sm">Permanente verwijdering van nare geuren (rooklucht, huisdieren, vocht en schimmels) door middel van een professionele ozongenerator.</p>
          </div>
        </div>
        <p class="text-xs text-gray-500 mt-4">* Tarieven voor cleaning zijn richttarieven en kunnen variëren afhankelijk van de grootte van de auto en de mate van vervuiling.</p>
      </div>
    </section>

    <!-- SECTION 3: DETAILING & POLIJSTEN -->
    <section class="py-20 bg-black border-t border-zinc-900 scroll-mt-36" id="detailing">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
          <div>
            <span class="text-gold-500 font-semibold text-sm uppercase tracking-wider">Lakcorrectie & Glansherstel</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white mt-1">Detailing & Polijsten</h2>
          </div>
          <p class="text-gray-400 text-sm mt-2 md:mt-0 max-w-md">
            Meerstaps machinaal polijsten om swirls, waskrassen en lakdefecten permanent te verwijderen.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- 1-Staps -->
          <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-6 flex flex-col justify-between hover:border-gold-500/50 transition-all">
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <span class="text-xs font-semibold uppercase tracking-wider text-gold-500">Duur: 1 Dag</span>
                <span class="text-2xl font-extrabold text-gold-500">v.a. € 239,-</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-3">1-Staps Polijsten</h3>
              <p class="text-gray-400 text-sm mb-6">Herstelt de diepe glans van de lak en corrigeert lichte waskrassen en dofheid.</p>
              
              <ul class="space-y-2.5 text-xs text-gray-300 mb-6">
                <li class="flex items-start gap-2">
                  <span class="text-gold-500 font-bold">✓</span>
                  <span>Schuimlans voorwas & 2-emmer handwas</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold-500 font-bold">✓</span>
                  <span>Deursponningen & velgen grondig reinigen</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold-500 font-bold">✓</span>
                  <span>Handmatig kleien (verwijderen teer, hars en vliegroest)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold-500 font-bold">✓</span>
                  <span>1-staps machinaal polijsten</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold-500 font-bold">✓</span>
                  <span>Duurzame lakverzegeling beschermlaag</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold-500 font-bold">✓</span>
                  <span>Interieur stofzuigen & kunststof afnemen</span>
                </li>
              </ul>
            </div>
            <a href="/contact" class="block text-center py-2.5 rounded-lg border border-zinc-700 text-white font-medium hover:border-gold-500 hover:text-gold-500 transition-colors text-sm">
              Offerte 1-Staps
            </a>
          </div>

          <!-- 2-Staps -->
          <div class="bg-zinc-900/60 border border-gold-500/30 rounded-xl p-6 flex flex-col justify-between relative shadow-lg shadow-gold-500/5">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gold-500 text-black text-[10px] font-extrabold px-3 py-0.5 rounded-full uppercase tracking-wider">
              Aanrader
            </div>
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <span class="text-xs font-semibold uppercase tracking-wider text-gold-500">Duur: 1,5 Dag</span>
                <span class="text-2xl font-extrabold text-gold-500">v.a. € 299,-</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-3">2-Staps Polijsten</h3>
              <p class="text-gray-400 text-sm mb-6">Verwijdert tot wel <strong>80% van alle krassen</strong> en herstelt een diepe spiegelglans.</p>
              
              <ul class="space-y-2.5 text-xs text-gray-300 mb-6">
                <li class="flex items-start gap-2">
                  <span class="text-gold-500 font-bold">✓</span>
                  <span>Alles uit het 1-staps pakket</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold-500 font-bold">✓</span>
                  <span>Stap 1: Grof polijsten voor krasverwijdering</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold-500 font-bold">✓</span>
                  <span>Stap 2: Fijn polijsten voor ultieme hoogglans (finish)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold-500 font-bold">✓</span>
                  <span>Lakverzegeling & bandendressing</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-gold-500 font-bold">✓</span>
                  <span>Interieur opfrisbeurt & ruiten streeploos</span>
                </li>
              </ul>
            </div>
            <a href="/contact" class="block text-center py-2.5 rounded-lg bg-gold-500 text-black font-bold hover:bg-gold-400 transition-colors text-sm">
              Offerte 2-Staps
            </a>
          </div>

