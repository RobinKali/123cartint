---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Portfolio - Ons Werk & Recente Projecten">
  <Header />
  
  <main class="pt-20">
    <!-- Hero Header -->
    <div class="bg-black py-16 md:py-20 text-center border-b border-zinc-900 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-zinc-900/20 to-transparent pointer-events-none"></div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-semibold uppercase tracking-widest mb-4">
          Exclusief Maatwerk
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">Ons <span class="text-gradient-red">Portfolio</span></h1>
        <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto">
          Ontdek een selectie van onze meest exclusieve projecten. Van subtiele raamtinting en lakbescherming tot complete kleurtransformaties.
        </p>
      </div>
    </div>
    
    <!-- Interactive Filterable Portfolio Grid -->
    <div class="bg-zinc-950 pb-20">
      <PortfolioGrid showTitle={false} showFilter={true} showCta={false} limit={50} />
    </div>

    <!-- CTA Section -->
    <section class="py-16 bg-black border-t border-zinc-900">
      <div class="max-w-5xl mx-auto px-4 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Geïnspireerd door onze projecten?</h2>
        <p class="text-gray-400 mb-8 max-w-xl mx-auto">Laat uw auto ook transformeren door onze specialisten. Neem vandaag nog contact met ons op om de mogelijkheden te bespreken.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="px-8 py-4 bg-red-500 hover:bg-red-400 text-black font-bold rounded-sm transition-colors shadow-lg shadow-red-500/10">
            Neem Contact Op
          </a>
          <a href="https://www.instagram.com/123cartint" target="_blank" rel="noopener noreferrer" class="px-8 py-4 border border-zinc-700 hover:border-pink-500/60 text-white font-semibold rounded-sm transition-colors flex items-center gap-2 bg-zinc-900/60">
            <svg class="h-5 w-5 text-pink-400" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
            </svg>
            <span>Volg ons op Instagram</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
