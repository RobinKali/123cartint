---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 - Pagina niet gevonden | 123cartint">
  <Header />

  <main class="min-h-[75vh] flex items-center justify-center bg-black relative overflow-hidden pt-20">
    <div class="absolute inset-0 bg-gradient-to-b from-black via-zinc-950 to-black pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-red-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-xl mx-auto px-4 text-center relative z-10 py-16">
      <span class="text-xs font-bold uppercase tracking-widest text-red-500 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 inline-block mb-4">
        Foutmelding 404
      </span>
      <h1 class="text-6xl md:text-8xl font-extrabold text-white tracking-tight mb-4">
        4<span class="text-gradient-red">0</span>4
      </h1>
      <h2 class="text-2xl font-bold text-white mb-4">
        Deze pagina is niet gevonden
      </h2>
      <p class="text-gray-400 text-base mb-8 max-w-md mx-auto">
        De opgevraagde pagina bestaat niet of is verhuisd. Keer terug naar de homepage of bekijk onze diensten.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-red-500 hover:bg-red-400 text-black font-bold transition-all shadow-lg shadow-red-500/20"
        >
          Terug naar Home
        </a>
        <a 
          href="/portfolio" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-full border border-zinc-700 hover:border-zinc-500 text-white font-medium transition-colors bg-zinc-900/60"
        >
          Bekijk Portfolio
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
