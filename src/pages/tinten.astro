---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Ramen Tinten - Premium Raamfolie">
  <Header />
  
  <main class="pt-20">
    <!-- Service Hero -->
    <div class="relative h-[60vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-transparent z-10" />
        <img 
          src="https://images.unsplash.com/photo-1605559424843-9e4c228bf1c2?q=80&w=2000&auto=format&fit=crop" 
          alt="Auto ramen tinten" 
          class="w-full h-full object-cover"
        />
      </div>
      <div class="relative z-20 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">Ramen <span class="text-gradient-gold">Tinten</span></h1>
        <p class="text-xl text-gray-300 max-w-2xl mb-8">
          Privacy, warmtewering en een exclusieve uitstraling. Wij werken uitsluitend met de beste folies op de markt.
        </p>
        <a href="/contact" class="inline-block px-8 py-4 bg-gold-500 text-black font-bold rounded-sm hover:bg-gold-400 transition-colors">
          Vraag offerte aan
        </a>
      </div>
    </div>

    <!-- Content Section -->
    <section class="py-24 bg-black">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
          <div>
            <h2 class="text-3xl font-bold text-white mb-6">Waarom kiezen voor professioneel blinderen?</h2>
            <div class="space-y-8">
              <div>
                <h3 class="text-xl font-semibold text-gold-500 mb-2">Maximale Privacy & Veiligheid</h3>
                <p class="text-gray-400">Verberg uw waardevolle spullen voor nieuwsgierige blikken en voorkom glassplinters in geval van een ongeluk.</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-gold-500 mb-2">Warmtewering & UV-bescherming</h3>
                <p class="text-gray-400">Onze premium folies blokkeren tot 99% van de schadelijke UV-straling en houden het interieur van uw auto aanzienlijk koeler in de zomer.</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-gold-500 mb-2">Exclusieve Uitstraling</h3>
                <p class="text-gray-400">Geef uw auto direct een sportievere en strakkere look. Wij snijden de folie digitaal op maat voor een perfect, naadloos resultaat.</p>
              </div>
            </div>
          </div>
          <div class="bg-zinc-900 p-8 rounded-lg border border-zinc-800">
            <h3 class="text-2xl font-bold text-white mb-6">Onze Tint Opties</h3>
            <ul class="space-y-4">
              <li class="flex justify-between items-center border-b border-zinc-800 pb-4">
                <span class="text-gray-300">Lichte Tint (70%)</span>
                <span class="text-gold-500 font-semibold">Toegestaan voorruit/voorste zijruiten*</span>
              </li>
              <li class="flex justify-between items-center border-b border-zinc-800 pb-4">
                <span class="text-gray-300">Medium Tint (35%)</span>
                <span class="text-gray-500 text-sm">Elegante verduistering</span>
              </li>
              <li class="flex justify-between items-center border-b border-zinc-800 pb-4">
                <span class="text-gray-300">Donkere Tint (20%)</span>
                <span class="text-gray-500 text-sm">Fabriekslook / Privacy Glass</span>
              </li>
              <li class="flex justify-between items-center pb-4">
                <span class="text-gray-300">Limo Tint (5%)</span>
                <span class="text-gray-500 text-sm">Maximale privacy (Bedrijfswagens)</span>
              </li>
            </ul>
            <p class="text-xs text-gray-500 mt-6 mb-6">* Binnen de wettelijke normen van de Nederlandse wetgeving.</p>
            <a href="/prijzen#tinten" class="inline-flex items-center gap-2 text-gold-500 hover:text-gold-400 font-bold text-sm">
              Bekijk alle tint tarieven per autotype
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
