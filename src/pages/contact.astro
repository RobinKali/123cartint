---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact - Vraag een offerte aan">
  <Header />
  
  <main class="pt-20">
    <div class="bg-black py-20 border-b border-zinc-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div>
          <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">Neem <span class="text-gradient-gold">Contact</span> Op</h1>
          <p class="text-gray-400 text-xl mb-8">
            Heeft u vragen over onze diensten of wilt u een vrijblijvende offerte aanvragen? Wij staan voor u klaar.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-start">
              <div class="flex-shrink-0 bg-zinc-900 p-3 rounded-full border border-zinc-800 text-gold-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-white">Bezoekadres (op afspraak)</h3>
                <p class="text-gray-400 mt-1">Exclusiveweg 1<br/>1234 AB Amsterdam</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="flex-shrink-0 bg-zinc-900 p-3 rounded-full border border-zinc-800 text-gold-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-white">Telefoon / WhatsApp</h3>
                <p class="text-gray-400 mt-1"><a href="tel:+31612345678" class="hover:text-gold-500 transition-colors">+31 6 1234 5678</a></p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="flex-shrink-0 bg-zinc-900 p-3 rounded-full border border-zinc-800 text-gold-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-white">E-mail</h3>
                <p class="text-gray-400 mt-1"><a href="mailto:info@123cartint.nl" class="hover:text-gold-500 transition-colors">info@123cartint.nl</a></p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Openingstijden -->
        <div class="bg-zinc-900 p-8 rounded-lg border border-zinc-800">
          <h3 class="text-2xl font-bold text-white mb-6">Openingstijden</h3>
          <ul class="space-y-4">
            <li class="flex justify-between items-center border-b border-zinc-800 pb-3">
              <span class="text-gray-300">Maandag - Vrijdag</span>
              <span class="text-gold-500">09:00 - 18:00</span>
            </li>
            <li class="flex justify-between items-center border-b border-zinc-800 pb-3">
              <span class="text-gray-300">Zaterdag</span>
              <span class="text-gold-500">10:00 - 16:00 (Op afspraak)</span>
            </li>
            <li class="flex justify-between items-center pb-3">
              <span class="text-gray-300">Zondag</span>
              <span class="text-red-500">Gesloten</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
    
    <!-- Contact Form (Reused Component) -->
    <ContactForm />
  </main>
  
  <Footer />
</Layout>
