---
const services = [
  {
    title: 'Ramen Tinten',
    subtitle: 'Privacy & Zonwering',
    description: 'Verhoog uw rijcomfort, bescherm het interieur tegen schadelijke UV-straling en geef uw voertuig een strakke, exclusieve fabriekslook.',
    image: 'https://images.unsplash.com/photo-1605559424843-9e4c228bf1c2?q=80&w=1200&auto=format&fit=crop',
    link: '/tinten',
    priceLink: '/prijzen#tinten',
    badge: 'Populairst',
    features: [
      'Tot 99% UV-wering & hitte-reductie',
      'Levenslange garantie op loslaten & bubbels',
      'Computergestuurde precieze snijmallen',
      'Keuze uit 5%, 20%, 35% en 70% tint'
    ]
  },
  {
    title: 'Car Wrapping',
    subtitle: 'Kleur & Styling',
    description: 'Transformeer het uiterlijk van uw auto volledig of accentueer specifieke delen met dechrome, spiegelkappen of een stijlvol zwart dak.',
    image: 'https://images.unsplash.com/photo-1580273916550-e323be2ae537?q=80&w=1200&auto=format&fit=crop',
    link: '/wrappen',
    priceLink: '/prijzen#wrappen',
    badge: 'Custom',
    features: [
      '200+ kleuren (Mat, Satijn, Glans, Metallic)',
      'A-merken: 3M & Avery Dennison',
      'Beschermt de originele fabriekslak',
      'Volledige transformatie of dechrome'
    ]
  },
  {
    title: 'Cleaning & Detailing',
    subtitle: 'Showroom Finish',
    description: 'Haal de ultieme glans naar boven met meertraps polijsten, keramische glascoatings en grondige interieur dieptereiniging.',
    image: 'https://images.unsplash.com/photo-1619682817481-e994891cd1f5?q=80&w=1200&auto=format&fit=crop',
    link: '/detailing',
    priceLink: '/prijzen#detailing',
    badge: 'Exclusief',
    features: [
      'Meer-staps lakcorrectie (krasverwijdering)',
      'Keramische coatings tot 5 jaar bescherming',
      'Interieur diepstoomreiniging & ozon',
      'Lederverzorging & hydrofobe bescherming'
    ]
  }
];
---

<section class="py-24 bg-black relative overflow-hidden" id="diensten">
  <!-- Subtle background glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-gold-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-400 text-xs font-semibold uppercase tracking-widest mb-4">
        Specialisaties
      </div>
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">
        Onze <span class="text-gradient-gold">Diensten</span>
      </h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        Hoogwaardige automotive behandelingen uitgevoerd door gecertificeerde specialisten met passie voor perfectie.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="group bg-zinc-900/60 rounded-xl border border-zinc-800 hover:border-gold-500/50 transition-all duration-500 overflow-hidden flex flex-col hover:shadow-2xl hover:shadow-gold-500/5">
          <!-- Image Banner -->
          <div class="relative h-60 overflow-hidden">
            <img 
              src={service.image} 
              alt={service.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-900 via-zinc-900/40 to-transparent"></div>
            
            <span class="absolute top-4 right-4 bg-zinc-950/80 backdrop-blur-md text-gold-400 border border-gold-500/30 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
              {service.badge}
            </span>

            <div class="absolute bottom-4 left-6">
              <span class="text-xs font-medium text-gold-500 uppercase tracking-wider">{service.subtitle}</span>
              <h3 class="text-2xl font-bold text-white">{service.title}</h3>
            </div>
          </div>

          <!-- Body -->
          <div class="p-6 md:p-8 flex-1 flex flex-col justify-between">
            <div>
              <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6">
                {service.description}
              </p>

              <ul class="space-y-3 mb-8">
                {service.features.map((feature) => (
                  <li class="flex items-start text-sm text-gray-300">
                    <svg class="h-5 w-5 text-gold-500 mr-2.5 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Action buttons -->
            <div class="pt-6 border-t border-zinc-800/80 flex items-center justify-between gap-3">
              <a 
                href={service.link}
                class="inline-flex items-center gap-1 text-sm font-semibold text-white group-hover:text-gold-400 transition-colors"
              >
                <span>Meer informatie</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>

              <a 
                href={service.priceLink}
                class="inline-flex items-center text-xs font-semibold px-3 py-2 rounded bg-zinc-800 hover:bg-gold-500 hover:text-black text-gray-200 transition-colors"
              >
                Bekijk Tarieven
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Quick link bar -->
    <div class="mt-12 bg-gradient-to-r from-zinc-900/90 via-zinc-900/60 to-zinc-900/90 border border-zinc-800 rounded-xl p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-gold-500/10 border border-gold-500/30 flex items-center justify-center flex-shrink-0 text-gold-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div>
          <h4 class="text-white font-bold text-lg">Benieuwd naar de exacte kosten voor uw auto?</h4>
          <p class="text-gray-400 text-sm">Bekijk onze overzichtelijke prijzenpagina per merk, model en uitvoering.</p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <a href="/prijzen" class="w-full sm:w-auto text-center px-6 py-3 bg-gold-500 hover:bg-gold-400 text-black font-bold text-sm rounded-sm transition-colors">
          Tarievenoverzicht Bekijken
        </a>
        <a href="https://giftcard.sumup.io/order/GWBQLDU/123cartint" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto text-center px-6 py-3 border border-zinc-700 hover:border-gold-500 text-gray-200 hover:text-gold-400 font-semibold text-sm rounded-sm transition-colors flex items-center justify-center gap-2">
          <span>🎁</span> Cadeaubon Bestellen
        </a>
      </div>
    </div>
  </div>
</section>
