---
import { Facebook, Instagram, Mail, MapPin, Phone } from 'lucide-react';
---

<footer class="bg-zinc-950 border-t border-zinc-900 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-1">
        <a href="/" class="flex-shrink-0 flex items-center mb-4">
          <span class="text-2xl font-bold tracking-tighter text-white">
            123<span class="text-gold-500">CARTINT</span>
          </span>
        </a>
        <p class="text-gray-400 mb-6">
          Premium car tinting, wrapping en detailing. Wij tillen de uitstraling van uw voertuig naar het hoogste niveau.
        </p>
        <div class="flex space-x-4">
          <a href="https://www.facebook.com/123cartint" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gold-500 transition-colors" aria-label="Facebook">
            <span class="sr-only">Facebook</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
            </svg>
          </a>
          <a href="https://www.instagram.com/123cartint" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gold-500 transition-colors" aria-label="Instagram">
            <span class="sr-only">Instagram</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.566.683.748 1.15.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Diensten -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-lg">Diensten</h3>
        <ul class="space-y-2">
          <li><a href="/tinten" class="text-gray-400 hover:text-gold-500 transition-colors">Ramen Tinten</a></li>
          <li><a href="/wrappen" class="text-gray-400 hover:text-gold-500 transition-colors">Car Wrapping</a></li>
          <li><a href="/detailing" class="text-gray-400 hover:text-gold-500 transition-colors">Cleaning & Detailing</a></li>
          <li><a href="/portfolio" class="text-gray-400 hover:text-gold-500 transition-colors">Portfolio</a></li>
          <li><a href="/prijzen" class="text-gold-500 hover:text-gold-400 transition-colors font-medium">Prijzen & Pakketten</a></li>
        </ul>
      </div>

      <!-- Bedrijf -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-lg">Bedrijf</h3>
        <ul class="space-y-2">
          <li><a href="/over-ons" class="text-gray-400 hover:text-gold-500 transition-colors">Over Ons</a></li>
          <li><a href="/contact" class="text-gray-400 hover:text-gold-500 transition-colors">Contact</a></li>
          <li><a href="https://giftcard.sumup.io/order/GWBQLDU/123cartint" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gold-500 transition-colors">🎁 Cadeaubon Bestellen</a></li>
          <li><a href="/prijzen" class="text-gray-400 hover:text-gold-500 transition-colors">Tarievenoverzicht</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-lg">Contact</h3>
        <ul class="space-y-4">
          <li class="flex items-start">
            <svg class="h-5 w-5 text-gold-500 mr-3 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <a href="https://maps.google.com/?q=Veilingstraat+1,+7545+LZ+Enschede" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gold-500 transition-colors">
              Veilingstraat 1<br/>7545 LZ Enschede
            </a>
          </li>
          <li class="flex items-center">
            <svg class="h-5 w-5 text-gold-500 mr-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
            <a href="tel:+31657273203" class="text-gray-400 hover:text-gold-500 transition-colors">+31 6 57 27 32 03</a>
          </li>
          <li class="flex items-center">
            <svg class="h-5 w-5 text-gold-500 mr-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href="mailto:info@123cartint.nl" class="text-gray-400 hover:text-gold-500 transition-colors">info@123cartint.nl</a>
          </li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-zinc-900 pt-8 flex flex-col md:flex-row justify-between items-center">
      <p class="text-gray-500 text-sm mb-4 md:mb-0">
        &copy; {new Date().getFullYear()} 123cartint. Alle rechten voorbehouden.
      </p>
      <p class="text-gray-500 text-sm">
        Premium Automotive Styling
      </p>
    </div>
  </div>
</footer>
