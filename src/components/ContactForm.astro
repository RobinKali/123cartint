---
---

<section class="py-24 bg-black relative" id="contact">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">Neem <span class="text-gradient-red">Contact</span> Op</h2>
      <p class="text-gray-400 text-lg">Klaar om uw auto te transformeren? Neem vandaag nog contact met ons op.</p>
    </div>

    <div id="contact-success-msg" class="hidden mb-8 p-6 rounded-lg bg-emerald-950/60 border border-emerald-500/50 text-emerald-300 text-center">
      <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-2">Aanvraag Verzonden!</h3>
      <p class="text-sm text-gray-300">Bedankt voor uw bericht. Wij nemen binnen 24 uur contact met u op.</p>
    </div>

    <form
      id="contact-form"
      action="/api/contact.php"
      method="POST"
      class="bg-zinc-900/50 p-8 rounded-lg border border-zinc-800 shadow-xl backdrop-blur-sm"
    >
      <!-- Anti-Spam Honeypot (onzichtbaar voor echte bezoekers) -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" style="display:none !important;" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
          <label for="naam" class="block text-sm font-medium text-gray-300 mb-2">Naam *</label>
          <input type="text" id="naam" name="naam" required
            class="w-full bg-zinc-950 border border-zinc-800 rounded-md py-3 px-4 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all"
            placeholder="Uw volledige naam"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-gray-300 mb-2">E-mailadres *</label>
          <input type="email" id="email" name="email" required
            class="w-full bg-zinc-950 border border-zinc-800 rounded-md py-3 px-4 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all"
            placeholder="uw.email@voorbeeld.nl"
          />
        </div>
      </div>
      
      <div class="mb-6">
        <label for="kenteken" class="block text-sm font-medium text-gray-300 mb-2">Kenteken (optioneel)</label>
        <input type="text" id="kenteken" name="kenteken"
          class="w-full bg-zinc-950 border border-zinc-800 rounded-md py-3 px-4 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all uppercase"
          placeholder="AB-123-C"
        />
      </div>

      <div class="mb-6">
        <label for="bericht" class="block text-sm font-medium text-gray-300 mb-2">Bericht *</label>
        <textarea id="bericht" name="bericht" rows="5" required
          class="w-full bg-zinc-950 border border-zinc-800 rounded-md py-3 px-4 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all"
          placeholder="Vertel ons over uw wensen (bijv. ramen blinderen vanaf b-stijl, volledige wrap in mat zwart...)"
        ></textarea>
      </div>

      <div id="contact-error-msg" class="hidden mb-4 p-3 rounded bg-red-950/60 border border-red-500/50 text-red-300 text-sm">
      </div>

      <button
        type="submit"
        id="contact-submit-btn"
        class="w-full bg-red-500 hover:bg-red-400 text-black font-bold py-4 px-8 rounded-md transition-colors duration-300 flex justify-center items-center gap-2 mt-4 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span id="contact-btn-text">Verstuur Aanvraag</span>
        <svg id="contact-btn-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
      </button>
    </form>
  </div>
</section>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const successBox = document.getElementById('contact-success-msg');
    const errorBox = document.getElementById('contact-error-msg');
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('contact-btn-text');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorBox) errorBox.classList.add('hidden');

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Verzenden...';

      const formData = new FormData(form);

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (res.ok) {
          form.reset();
          form.classList.add('hidden');
          if (successBox) successBox.classList.remove('hidden');
        } else {
          const data = await res.json().catch(() => ({}));
          const msg = data.error || 'Er ging iets mis bij het verzenden. Neem direct contact op via WhatsApp of telefoon.';
          if (errorBox) {
            errorBox.textContent = msg;
            errorBox.classList.remove('hidden');
          }
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Verstuur Aanvraag';
        }
      } catch {
        // Fallback als backend offline is of lokaal zonder PHP draait
        if (errorBox) {
          errorBox.textContent = 'Verbinding mislukt. U kunt ons ook direct bereiken via WhatsApp (+31 6 57 27 32 03).';
          errorBox.classList.remove('hidden');
        }
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Verstuur Aanvraag';
      }
    });
  }

  document.addEventListener('astro:page-load', setupContactForm);
</script>
