---
const steps = [
  {
    step: '01',
    title: 'Vrijblijvend Advies & Offerte',
    description: 'We bespreken uw wensen, adviseren over tintpercentages of wrapkleuren en geven direct een heldere prijsopgave zonder verrassingen achteraf.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />`
  },
  {
    step: '02',
    title: 'Afspraak & Voorbereiding',
    description: 'We reserveren tijd in onze geconditioneerde, stofvrije werkplaats. Uw auto wordt eerst grondig gewassen, ontvet en geïnspecteerd.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`
  },
  {
    step: '03',
    title: 'Vakkundige Montage',
    description: 'Met digitale snijmallen en uitsluitend A-merken (3M, Avery, SunTek) brengen onze gecertificeerde experts de folie of coating naadloos aan.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`
  },
  {
    step: '04',
    title: 'Controle, Oplevering & Garantie',
    description: 'Na een strenge inspectie onder speciaal inspectielicht leveren we uw auto smetteloos op, inclusief garantiecertificaat en handige nazorgtips.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`
  }
];

const guarantees = [
  {
    title: 'Levenslange Garantie',
    desc: 'Op loslaten, scheuren of bubbels bij raamblindering.',
    icon: '🛡️'
  },
  {
    title: 'A-Kwaliteit Materialen',
    desc: 'Uitsluitend 3M, Avery Dennison, Xpel en Gyeon.',
    icon: '✨'
  },
  {
    title: 'Stofvrije Studio',
    desc: 'Geconditioneerde omgeving voor een foutloos resultaat.',
    icon: '🏢'
  },
  {
    title: 'Klantwaardering 4.9/5',
    desc: 'Meer dan 2.500 tevreden klanten in het topsegment.',
    icon: '⭐'
  }
];
---

<section class="py-24 bg-zinc-950 relative border-t border-zinc-900 overflow-hidden" id="werkwijze">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-400 text-xs font-semibold uppercase tracking-widest mb-4">
        Transparant Proces
      </div>
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">
        Onze <span class="text-gradient-gold">Werkwijze</span>
      </h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        In vier duidelijke stappen naar een ongeëvenaard eindresultaat. Geen verrassingen, enkel puur vakmanschap.
      </p>
    </div>

    <!-- 4 Steps Timeline Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative mb-20">
      {steps.map((item, index) => (
        <div class="bg-zinc-900/70 border border-zinc-800 hover:border-gold-500/40 rounded-xl p-6 relative group transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-12 h-12 rounded-lg bg-gold-500/10 border border-gold-500/30 text-gold-500 flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.icon} />
              </div>
              <span class="text-2xl font-black text-zinc-700 group-hover:text-gold-500/80 transition-colors">
                {item.step}
              </span>
            </div>

            <h3 class="text-lg font-bold text-white mb-3 group-hover:text-gold-400 transition-colors">
              {item.title}
            </h3>

            <p class="text-gray-400 text-sm leading-relaxed">
              {item.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-zinc-800/60 flex items-center gap-2 text-xs text-gold-500/90 font-medium">
            <span>Stap {index + 1} van 4</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Guarantees & Trust Banner -->
    <div class="border border-zinc-800 bg-black/60 rounded-2xl p-8 lg:p-10 backdrop-blur-sm">
      <div class="text-center max-w-xl mx-auto mb-10">
        <h3 class="text-2xl font-bold text-white mb-2">Waarom kiezen voor <span class="text-gradient-gold">123cartint</span>?</h3>
        <p class="text-gray-400 text-sm">Wij combineren passie voor auto's met ongeëvenaarde servicenormen.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {guarantees.map((item) => (
          <div class="p-4 rounded-lg bg-zinc-900/50 border border-zinc-800/80 text-left hover:border-gold-500/30 transition-colors">
            <span class="text-2xl mb-3 block">{item.icon}</span>
            <h4 class="text-white font-bold text-base mb-1">{item.title}</h4>
            <p class="text-gray-400 text-xs leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
