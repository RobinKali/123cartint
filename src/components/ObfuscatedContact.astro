---
interface Props {
  type: "email" | "tel" | "text";
  value: string;
  display?: string;
  class?: string;
}

const { type, value, display, class: className } = Astro.props;

// Encode strings in base64 on the server so scrapers don't find plain text or mailto/tel links in raw HTML
const encodedValue = Buffer.from(value).toString('base64');
const encodedDisplay = display ? Buffer.from(display).toString('base64') : encodedValue;
---

<obfuscated-contact
  data-type={type}
  data-value={encodedValue}
  data-display={encodedDisplay}
  data-class={className || ""}
>
</obfuscated-contact>

<style>
  obfuscated-contact {
    display: contents;
  }
</style>

<script>
  class ObfuscatedContactElement extends HTMLElement {
    connectedCallback() {
      if (this.dataset.rendered) return;
      this.dataset.rendered = "true";

      const type = this.getAttribute('data-type');
      const rawVal = this.getAttribute('data-value');
      const rawDisp = this.getAttribute('data-display');
      if (!rawVal) return;

      try {
        const value = atob(rawVal);
        const display = rawDisp ? atob(rawDisp) : value;
        const className = this.getAttribute('data-class') || '';

        if (type === 'email') {
          this.innerHTML = `<a href="mailto:${value}" class="${className}">${display}</a>`;
        } else if (type === 'tel') {
          this.innerHTML = `<a href="tel:${value}" class="${className}">${display}</a>`;
        } else {
          this.innerHTML = `<span class="${className}">${display}</span>`;
        }
      } catch (e) {
        console.error('Error decoding obfuscated contact:', e);
      }
    }
  }

  if (!customElements.get('obfuscated-contact')) {
    customElements.define('obfuscated-contact', ObfuscatedContactElement);
  }
</script>

