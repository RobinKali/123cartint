---
interface Props {
  showTitle?: boolean;
  showFilter?: boolean;
  showCta?: boolean;
  defaultFilter?: string;
  limit?: number;
}

const {
  showTitle = true,
  showFilter = false,
  showCta = true,
  defaultFilter = 'all',
  limit
} = Astro.props;

// Portfolio dataset
const allItems = [
  { id: '1', title: 'Mat Zwart Wrap', category: 'Wrappen', categoryLabel: 'Car Wrapping', brand: 'Porsche 911 GT3', imageUrl: '/images/portfolio/mat-zwart-wrap.jpg' },
  { id: '2', title: 'Keramische Coating', category: 'Detailing', categoryLabel: 'Cleaning & Detailing', brand: 'Audi RS6', imageUrl: '/images/portfolio/keramische-coating.jpg' },
  { id: '3', title: 'Ramen Tinten 20%', category: 'Tinten', categoryLabel: 'Ramen Tinten', brand: 'Mercedes G-Klasse', imageUrl: 'https://images.unsplash.com/photo-1605559424843-9e4c228bf1c2?q=80&w=2000&auto=format&fit=crop' },
  { id: '4', title: 'Satin Grey Wrap', category: 'Wrappen', categoryLabel: 'Car Wrapping', brand: 'BMW M4', imageUrl: 'https://images.unsplash.com/photo-1580273916550-e323be2ae537?q=80&w=2000&auto=format&fit=crop' },
  { id: '5', title: 'Interieur Reiniging', category: 'Detailing', categoryLabel: 'Cleaning & Detailing', brand: 'Range Rover', imageUrl: '/images/portfolio/interieur-reiniging.jpg' },
  { id: '6', title: 'Chameleon Tint', category: 'Tinten', categoryLabel: 'Ramen Tinten', brand: 'VW Golf GTI', imageUrl: '/images/portfolio/chameleon-tint.jpg' },
  { id: '7', title: 'Dechrome & Styling Wrap', category: 'Wrappen', categoryLabel: 'Car Wrapping', brand: 'Audi RS3 Sportback', imageUrl: 'https://images.unsplash.com/photo-1603584173870-7f23fdae1b7a?q=80&w=2000&auto=format&fit=crop' },
  { id: '8', title: 'Privacy Glass 5%', category: 'Tinten', categoryLabel: 'Ramen Tinten', brand: 'BMW 3 Serie Touring', imageUrl: 'https://images.unsplash.com/photo-1555353540-64580b51c258?q=80&w=2000&auto=format&fit=crop' },
  { id: '9', title: 'Lakcorrectie & Coating', category: 'Detailing', categoryLabel: 'Cleaning & Detailing', brand: 'Mercedes-AMG GT', imageUrl: 'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?q=80&w=2000&auto=format&fit=crop' }
];

const items = typeof limit === 'number' ? allItems.slice(0, limit) : allItems;

const filterCategories = [
  { id: 'all', label: 'Alle Projecten' },
  { id: 'Tinten', label: 'Ramen Tinten' },
  { id: 'Wrappen', label: 'Car Wrapping' },
  { id: 'Detailing', label: 'Cleaning & Detailing' }
];
---

<section class="py-16 md:py-24 bg-zinc-950" id="portfolio">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {showTitle && (
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">Ons <span class="text-gradient-gold">Vakmanschap</span></h2>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto">Een selectie van onze meest recente en exclusieve projecten. Perfectie tot in het kleinste detail.</p>
      </div>
    )}

    {showFilter && (
      <div class="flex flex-wrap justify-center gap-3 md:gap-4 mb-12" id="portfolio-filters">
        {filterCategories.map((cat) => (
          <button 
            type="button"
            data-filter={cat.id} 
            class={`portfolio-filter-btn px-6 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 border ${
              cat.id === defaultFilter 
                ? 'bg-gold-500 text-black border-gold-500 shadow-lg shadow-gold-500/20 active-filter' 
                : 'bg-zinc-900/80 text-gray-300 border-zinc-700/80 hover:border-gold-500/60 hover:text-gold-400'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 auto-rows-[280px] md:auto-rows-[300px]" id="portfolio-grid">
      {items.map((item, index) => {
        const isFeatured = index === 0 || index === 3;
        
        return (
          <div 
            class={`portfolio-item group relative overflow-hidden rounded-xl bg-zinc-900 border border-zinc-800/80 transition-all duration-500 ${
              isFeatured ? 'featured-item md:col-span-2 md:row-span-2' : ''
            }`}
            data-category={item.category}
          >
            <img 
              src={item.imageUrl} 
              alt={item.title} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
              <span class="text-gold-500 font-medium text-xs md:text-sm mb-1 uppercase tracking-wider">{item.categoryLabel}</span>
              <h3 class="text-white text-xl md:text-2xl font-bold">{item.title}</h3>
              <p class="text-gray-300 text-sm mt-1">{item.brand}</p>
            </div>
          </div>
        )
      })}
    </div>

    <div id="portfolio-no-results" class="hidden text-center py-16">
      <p class="text-gray-400 text-lg">Geen projecten gevonden in deze categorie.</p>
    </div>

    {showCta && (
      <div class="mt-16 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/portfolio" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-sm bg-gold-500 text-black font-bold hover:bg-gold-400 transition-all duration-300 shadow-lg shadow-gold-500/10">
          Bekijk Volledig Portfolio
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        
        <a 
          href="https://www.instagram.com/123cartint" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-sm border border-zinc-700 bg-zinc-900/80 text-white font-semibold hover:border-pink-500/60 hover:text-white hover:bg-gradient-to-r hover:from-purple-900/40 hover:via-pink-900/30 hover:to-amber-900/30 transition-all duration-300 group"
        >
          <svg class="h-5 w-5 text-pink-400 group-hover:scale-110 transition-transform duration-300" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
          </svg>
          <span>Volg ons op Instagram</span>
        </a>
      </div>
    )}
  </div>
</section>

<script>
  function setupPortfolioFilter() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.portfolio-filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.portfolio-item');
    const noResults = document.getElementById('portfolio-no-results');

    if (!filterButtons.length || !items.length) return;

    function applyFilter(category: string) {
      let visibleCount = 0;

      // Update button active state
      filterButtons.forEach((btn) => {
        const btnFilter = btn.dataset.filter;
        if (btnFilter === category) {
          btn.classList.add('bg-gold-500', 'text-black', 'border-gold-500', 'shadow-lg', 'shadow-gold-500/20', 'active-filter');
          btn.classList.remove('bg-zinc-900/80', 'text-gray-300', 'border-zinc-700/80');
        } else {
          btn.classList.remove('bg-gold-500', 'text-black', 'border-gold-500', 'shadow-lg', 'shadow-gold-500/20', 'active-filter');
          btn.classList.add('bg-zinc-900/80', 'text-gray-300', 'border-zinc-700/80');
        }
      });

      // Filter portfolio items
      items.forEach((item) => {
        const itemCategory = item.dataset.category;
        const matches = category === 'all' || itemCategory === category;

        if (matches) {
          item.classList.remove('hidden');
          // When filtering specific category, reset span for uniform grid view
          if (category !== 'all') {
            item.classList.remove('md:col-span-2', 'md:row-span-2');
          } else if (item.classList.contains('featured-item')) {
            item.classList.add('md:col-span-2', 'md:row-span-2');
          }
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    // Attach click listeners
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';
        applyFilter(filter);
      });
    });

    // Check URL query param or hash on initial load (e.g. #Tinten or ?filter=tinten)
    const urlParams = new URLSearchParams(window.location.search);
    const filterParam = urlParams.get('filter') || window.location.hash.replace('#', '');
    if (filterParam) {
      const match = Array.from(filterButtons).find(
        (b) => b.dataset.filter?.toLowerCase() === filterParam.toLowerCase()
      );
      if (match && match.dataset.filter) {
        applyFilter(match.dataset.filter);
      }
    }
  }

  // Run on initial load and Astro client transitions
  document.addEventListener('astro:page-load', setupPortfolioFilter);
</script>
