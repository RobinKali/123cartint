---
// Mock data placeholder for Sanity CMS
const items = [
  { title: 'Mat Zwart Wrap', category: 'Wrappen', brand: 'Porsche 911 GT3', imageUrl: '/images/portfolio/mat-zwart-wrap.jpg' },
  { title: 'Keramische Coating', category: 'Detailing', brand: 'Audi RS6', imageUrl: '/images/portfolio/keramische-coating.jpg' },
  { title: 'Ramen Tinten 20%', category: 'Tinten', brand: 'Mercedes G-Klasse', imageUrl: 'https://images.unsplash.com/photo-1605559424843-9e4c228bf1c2?q=80&w=2000&auto=format&fit=crop' },
  { title: 'Satin Grey Wrap', category: 'Wrappen', brand: 'BMW M4', imageUrl: 'https://images.unsplash.com/photo-1580273916550-e323be2ae537?q=80&w=2000&auto=format&fit=crop' },
  { title: 'Interieur Reiniging', category: 'Detailing', brand: 'Range Rover', imageUrl: '/images/portfolio/interieur-reiniging.jpg' },
  { title: 'Chameleon Tint', category: 'Tinten', brand: 'VW Golf GTI', imageUrl: '/images/portfolio/chameleon-tint.jpg' },
];
---

<section class="py-24 bg-zinc-950" id="portfolio">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">Ons <span class="text-gradient-gold">Vakmanschap</span></h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">Een selectie van onze meest recente en exclusieve projecten. Perfectie tot in het kleinste detail.</p>
    </div>

    <!-- Masonry-like CSS Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 auto-rows-[300px]">
      {items.map((item, index) => {
        // Make the first and fourth items span 2 rows and columns for a dynamic layout on larger screens
        const isLarge = index === 0 || index === 3;
        
        return (
          <div class={`group relative overflow-hidden rounded-lg bg-zinc-900 ${isLarge ? 'md:col-span-2 md:row-span-2' : ''}`}>
            <img 
              src={item.imageUrl} 
              alt={item.title} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
              <span class="text-gold-500 font-medium text-sm mb-1 uppercase tracking-wider">{item.category}</span>
              <h3 class="text-white text-xl md:text-2xl font-bold">{item.title}</h3>
              <p class="text-gray-300 mt-2">{item.brand}</p>
            </div>
          </div>
        )
      })}
    </div>

    <div class="mt-16 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/portfolio" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-sm bg-gold-500 text-black font-bold hover:bg-gold-400 transition-all duration-300 shadow-lg shadow-gold-500/10">
        Bekijk Volledig Portfolio
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      
      <a 
        href="https://www.instagram.com/123cartint" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-sm border border-zinc-700 bg-zinc-900/80 text-white font-semibold hover:border-pink-500/60 hover:text-white hover:bg-gradient-to-r hover:from-purple-900/40 hover:via-pink-900/30 hover:to-amber-900/30 transition-all duration-300 group"
      >
        <svg class="h-5 w-5 text-pink-400 group-hover:scale-110 transition-transform duration-300" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
        </svg>
        <span>Volg ons op Instagram</span>
      </a>
    </div>
  </div>
</section>
